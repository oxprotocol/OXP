{
  "capability": "statusBar",
  "spec": "spec/v1/oxp-api.md#ctxstatusbar--status-bar-items",
  "scenarios": [
    {
      "name": "item shows after activate",
      "steps": [
        { "expect": "statusBarItem", "id": "conf.status", "textMatches": "conf" }
