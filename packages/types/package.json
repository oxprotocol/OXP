{
  "name": "@oxprotocol/types",
  "version": "0.3.0",
  "description": "TypeScript types for the OXP manifest and protocol. Source of truth: spec/v1/manifest.schema.json.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run --passWithNoTests"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
