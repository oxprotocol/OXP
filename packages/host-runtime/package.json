{
  "name": "@oxprotocol/host-runtime",
  "version": "0.1.4",
  "description": "Runtime-agnostic OXP component runtime: HostRuntime interface, capability broker, and the permission-gating layer that mediates every host call from a Wasm extension. Real wasmtime / jco backends plug in via the HostRuntime interface; this package owns the contract every backend must satisfy.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bytecodealliance/jco": "^1.19.0",
    "@bytecodealliance/preview2-shim": "^0.17.9",
    "@oxprotocol/types": "workspace:*",
    "@oxprotocol/wit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "5.9.3",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
