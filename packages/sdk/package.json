{
  "name": "@oxprotocol/sdk",
  "version": "0.1.5",
  "description": "Author-facing SDK for OXP extensions. Stable surface for `host` API, defineExtension(), and typed manifests. Works in VS Code webviews, Piye Workers, and `oxp dev`.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@oxprotocol/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
